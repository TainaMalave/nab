<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- HDR monitors only. "hue" (default): colours brighter than SDR white are scaled down keeping their hue.
         "clip": per-channel hard clip, identical to Windows Snipping Tool. Restart Snapshot after changing. -->
    <add key="HdrToneMap" value="hue" />
    <!-- HDR monitors only. Linear brightness after SDR-white normalisation, before hue/clip.
         1.0 = v5 look, 1.10 = default (slightly brighter), 1.2 = a bit brighter still. Range 0.5–2.0.
         Restart Snapshot after changing. -->
    <add key="HdrBrightness" value="1.10" />
  </appSettings>
</configuration>
